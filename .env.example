# ─── RailGati Environment Configuration ───────────────────
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# Application
RAILGATI_ENV=development
RAILGATI_DEBUG=true
RAILGATI_LOG_LEVEL=INFO

# Backend
RAILGATI_HOST=127.0.0.1
RAILGATI_PORT=8000

# Database (matches docker/docker-compose.yml defaults)
RAILGATI_DATABASE_URL=postgresql+psycopg2://railgati:railgati_dev@localhost:5433/railgati

# CORS
RAILGATI_FRONTEND_ORIGIN=http://localhost:3000
